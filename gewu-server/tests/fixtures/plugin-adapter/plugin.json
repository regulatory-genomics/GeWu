{
  "apiVersion": "gewu.plugin/v1",
  "id": "demo",
  "version": "0.1.0",
  "title": "Demo adapter",
  "scope": "workspace",
  "backend": {"connector": "gewu-stdio", "config": {"entry": "adapter.py"}},
  "settingsSchema": {"type":"object", "properties":{"service":{"type":"string"},"serviceProtocol":{"enum":["http","websocket"]}}, "additionalProperties":false},
