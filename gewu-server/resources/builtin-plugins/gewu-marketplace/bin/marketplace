#!/usr/bin/env python3
import json
import sys

for line in sys.stdin:
    request = json.loads(line)
    if request.get("op") == "activate":
        response = {"type": "result", "id": request["id"], "result": {"tools": [], "serviceEndpoints": []}}
    elif request.get("op") == "deactivate":
        response = {"type": "result", "id": request["id"], "result": {"stopped": True}}
    else:
        response = {"type": "error", "id": request["id"], "error": {"code": "HOST_OWNED", "message": "Marketplace lifecycle actions are host-owned", "retryable": False}}
    print(json.dumps(response), flush=True)
