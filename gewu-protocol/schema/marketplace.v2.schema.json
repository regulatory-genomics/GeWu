{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gewu:marketplace:v2",
  "$ref": "#/$defs/SignedMarketplaceIndex",
  "$defs": {
    "Version": {"const": "gewu.marketplace/v2"},
    "Url": {"type": "string", "pattern": "^https?://[^\\s]+$"},
    "Signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "value"], "properties": {
      "algorithm": {"const": "ed25519"},
      "keyId": {"type": "string", "minLength": 1},
      "value": {"type": "string", "minLength": 1}
    }},
    "Digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "Artifact": {"type": "object", "additionalProperties": false, "required": ["url", "sha256", "bytes"], "properties": {
      "url": {"$ref": "#/$defs/Url"}, "sha256": {"$ref": "#/$defs/Digest"}, "bytes": {"type": "integer", "minimum": 1}
    }},
    "Target": {"type": "object", "additionalProperties": false, "required": ["os", "arch"], "properties": {
      "os": {"enum": ["linux", "macos"]}, "arch": {"enum": ["x86_64", "aarch64"]}, "libc": {"type": "string", "minLength": 1}
    }},
    "Probe": {"type": "object", "additionalProperties": false, "required": ["args"], "properties": {
      "args": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
      "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
    }},
    "ExecutableHint": {"type": "object", "additionalProperties": false, "properties": {
      "env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
      "commands": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 16}
    }},
    "Binaries": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "External": {"type": "object", "additionalProperties": false,
      "required": ["kind", "id", "target", "executable", "probe"],
      "properties": {
        "kind": {"const": "external"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$"},
        "target": {"$ref": "#/$defs/Target"}, "executable": {"$ref": "#/$defs/ExecutableHint"},
        "probe": {"$ref": "#/$defs/Probe"}, "binaries": {"$ref": "#/$defs/Binaries"}
      }},
    "Managed": {"type": "object", "additionalProperties": false,
      "required": ["kind", "id", "target", "manager", "packages", "probe"],
      "properties": {
        "kind": {"const": "managed"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$"},
        "target": {"$ref": "#/$defs/Target"}, "manager": {"enum": ["micromamba"]},
        "channels": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 16},
        "packages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "maxItems": 256},
        "pip": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 256},
        "pipIndex": {"$ref": "#/$defs/Url"},
        "pipExtraIndex": {"$ref": "#/$defs/Url"},
        "probe": {"$ref": "#/$defs/Probe"}, "binaries": {"$ref": "#/$defs/Binaries"}
      }},
    "Bundled": {"type": "object", "additionalProperties": false,
      "required": ["kind", "id", "version", "target", "artifact", "manifest"],
      "properties": {
        "kind": {"const": "bundled"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$"},
        "version": {"$ref": "#/$defs/Semver"}, "target": {"$ref": "#/$defs/Target"},
        "artifact": {"$ref": "#/$defs/Artifact"}, "manifest": {"$ref": "#/$defs/Artifact"}
      }},
    "Provider": {"oneOf": [
      {"$ref": "#/$defs/External"}, {"$ref": "#/$defs/Managed"}, {"$ref": "#/$defs/Bundled"}
    ]},
    "RuntimePlan": {"type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "policies", "providers"],
      "properties": {
        "schemaVersion": {"const": "gewu.runtime-plan/v1"},
        "policies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["external", "managed", "bundled"]}},
        "providers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Provider"}}
      }},
    "Release": {"type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "releaseId", "plugin", "version", "channel", "gewu", "package", "capabilities", "permissions", "provenance"],
      "properties": {
        "schemaVersion": {"type": "string", "pattern": "^gewu\\.release/v[12]$"},
        "releaseId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$"},
        "plugin": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$"},
        "version": {"$ref": "#/$defs/Semver"},
        "channel": {"enum": ["stable", "beta", "nightly"]},
        "gewu": {"type": "object", "additionalProperties": false, "required": ["api", "host"], "properties": {"api": {"const": "gewu.plugin/v1"}, "host": {"type": "string", "minLength": 1}}},
        "package": {"$ref": "#/$defs/Artifact"},
        "runtimes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "version", "target", "artifact", "manifest"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$"}, "version": {"$ref": "#/$defs/Semver"}, "target": {"$ref": "#/$defs/Target"}, "artifact": {"$ref": "#/$defs/Artifact"}, "manifest": {"$ref": "#/$defs/Artifact"}}}},
        "runtimePlan": {"$ref": "#/$defs/RuntimePlan"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "provenance": {"type": "object", "additionalProperties": false, "required": ["builder", "source", "sourceCommit", "buildInputs", "createdAt"], "properties": {"builder": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "sourceCommit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"}, "buildInputs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "sbom": {"$ref": "#/$defs/Url"}, "createdAt": {"type": "string", "minLength": 1}}},
        "releaseNotes": {"type": "string"},
        "revocation": {"type": "object", "additionalProperties": false, "required": ["reason", "revokedAt"], "properties": {"reason": {"type": "string", "minLength": 1}, "revokedAt": {"type": "string", "minLength": 1}}}
      }
    },
    "Index": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "repository", "generatedAt", "expiresAt", "keyId", "releases"], "properties": {
      "schemaVersion": {"$ref": "#/$defs/Version"},
      "repository": {"type": "string", "minLength": 1},
      "generatedAt": {"type": "string", "minLength": 1},
      "expiresAt": {"type": "string", "minLength": 1},
      "keyId": {"type": "string", "minLength": 1},
      "releases": {"type": "array", "items": {"$ref": "#/$defs/Release"}}
    }},
    "SignedMarketplaceIndex": {"type": "object", "additionalProperties": false, "required": ["index", "signature"], "properties": {
      "index": {"$ref": "#/$defs/Index"},
      "signature": {"$ref": "#/$defs/Signature"}
    }}
  }
}
