{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gewu:runtime:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "plugin", "target", "launcher", "probe", "capabilities", "installation"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$"},
    "path": {"type": "string", "pattern": "^[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*$"}
  },
  "properties": {
    "schemaVersion": {"const": "gewu.runtime/v2"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "plugin": {"$ref": "#/$defs/id"},
    "target": {"type": "object", "additionalProperties": false, "required": ["os", "arch"], "properties": {
      "os": {"enum": ["linux", "macos"]}, "arch": {"enum": ["x86_64", "aarch64"]}, "libc": {"const": "glibc"}
    }},
    "launcher": {"$ref": "#/$defs/path"},
    "probe": {"$ref": "#/$defs/path"},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "probeTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "installation": {"oneOf": [
      {"type": "object", "required": ["kind"], "additionalProperties": false, "properties": {"kind": {"const": "ready"}}},
      {"type": "object", "required": ["kind", "archive", "unpacker", "environmentName"], "additionalProperties": false,
       "properties": {"kind": {"const": "pixi-pack"}, "archive": {"$ref": "#/$defs/path"}, "unpacker": {"$ref": "#/$defs/path"}, "environmentName": {"const": "env"}}}
    ]}
  }
}
